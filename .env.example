# Backend
RETURNREVIEW_ENV=development
RETURNREVIEW_DATABASE_URL=sqlite:///./returnreview.db
RETURNREVIEW_DATABASE_SCHEMA=
RETURNREVIEW_STORAGE_DIR=./storage
RETURNREVIEW_ALLOWED_ORIGINS=http://localhost:3000
RETURNREVIEW_MAX_UPLOAD_MB=10
RETURNREVIEW_DEMO_MODE=true
RETURNREVIEW_CV_MODEL_PATH=./models/checkpoints/best.pt
RETURNREVIEW_CV_MODEL_VERSION=untrained
RETURNREVIEW_CATEGORY_MODEL_PATH=./models/category_mobilenet_v3_small.pt
RETURNREVIEW_CATEGORY_PROBABILITY_THRESHOLD=0.50
RETURNREVIEW_CLIP_MODEL=ViT-B-32
RETURNREVIEW_CLIP_PRETRAINED=laion2b_s34b_b79k
RETURNREVIEW_PROTOTYPE_BANK_PATH=./models/prototypes.npz
RETURNREVIEW_CATEGORY_SIMILARITY_THRESHOLD=0.72
RETURNREVIEW_DEFECT_SIMILARITY_THRESHOLD=0.66
RETURNREVIEW_DEFECT_MARGIN_THRESHOLD=0.03
RETURNREVIEW_GEMINI_API_KEY=
RETURNREVIEW_GEMINI_MODEL=gemini-3.8-flash
RETURNREVIEW_GEMINI_FALLBACK_MODEL=gemini-3.5-flash
RETURNREVIEW_LLM_EVAL_MODEL=
RETURNREVIEW_LLM_ENABLED=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# One-time controlled Gemini evaluation. Keep false during normal runtime.
RETURNREVIEW_RUN_LLM_EVAL_ON_START=false
